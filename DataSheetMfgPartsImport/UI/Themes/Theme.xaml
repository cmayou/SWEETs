<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Data Sheet MFG Parts Import uses the shared SWEETs theme (src\SWEETs.UI\Theme.xaml).
         This file only maps the importer's own resource keys onto it, so the XAML and Converters.cs keep working.
         Change colours and styles in SWEETs.UI, not here. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SWEETs.UI;component/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Colour keys (values = SWEETs palette) ===== -->
    <Color x:Key="SurfaceColor">#F5F6F8</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="HeaderColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#DADDE3</Color>
    <Color x:Key="BorderStrongColor">#B8BDC7</Color>
    <Color x:Key="TextColor">#111827</Color>
    <Color x:Key="TextMutedColor">#4B5563</Color>
    <Color x:Key="AccentColor">#1D4ED8</Color>
    <Color x:Key="AccentHoverColor">#1E40AF</Color>
    <Color x:Key="AccentSoftColor">#E8EEFD</Color>
    <Color x:Key="SuccessColor">#047857</Color>
    <Color x:Key="SuccessSoftColor">#E6F4EE</Color>
    <Color x:Key="WarningColor">#B45309</Color>
    <Color x:Key="WarningSoftColor">#FDF3E6</Color>
    <Color x:Key="CautionColor">#7C3AED</Color>
    <Color x:Key="DangerColor">#B91C1C</Color>
    <Color x:Key="DangerSoftColor">#FBEAEA</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource CautionColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />

    <!-- ===== Typography ===== -->
    <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}" />
    <Style x:Key="SectionText" TargetType="TextBlock" BasedOn="{StaticResource Text.Overline}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}" />
    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MetricText" TargetType="TextBlock" BasedOn="{StaticResource Text.Kpi}" />

    <!-- ===== Containers (Card and Badge keep the importer's spacing) ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="ButtonBase" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}" />
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}" />
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Btn.Primary}" />
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}" />
    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}" />

    <!-- ===== Inputs ===== -->
    <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}" />
    <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="SelectCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="SlimProgress" TargetType="ProgressBar" BasedOn="{StaticResource ThinProgress}" />

    <!-- FocusRing, Segment and the implicit ToolTip style come from SWEETs.UI. -->
</ResourceDictionary>
