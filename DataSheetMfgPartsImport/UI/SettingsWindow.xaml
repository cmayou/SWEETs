<Window x:Class="DataSheetMfgPartsImport.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Sheet MFG Parts Import: Settings" Width="660" Height="780" MinWidth="520" MinHeight="480"
        Icon="/DataSheetMfgPartsImport;component/Icons/import32.png"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DataSheetMfgPartsImport;component/UI/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Row" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Header.Bar}">
            <StackPanel>
                <TextBlock Style="{StaticResource Header.Overline}" Text="SWEETs · Data Sheet MFG Parts Import" />
                <TextBlock Style="{StaticResource Header.Title}" Text="Settings" />
                <TextBlock Style="{StaticResource Header.Subtitle}" Text="How data sheets are read and how parts are added to the library" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="16,16,16,0">

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="READING DATA SHEETS" Style="{StaticResource SectionText}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Engine" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <ComboBox x:Name="EngineBox" Style="{StaticResource FieldCombo}" SelectionChanged="OnEngineChanged"
                                      AutomationProperties.Name="Reading engine">
                                <ComboBoxItem Content="Offline rules (PDFs with selectable text; nothing leaves this PC)" />
                                <ComboBoxItem Content="Local AI with Ollama (PDFs and photos; nothing leaves this PC)" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="OllamaPanel">
                            <StackPanel Style="{StaticResource Row}">
                                <TextBlock Text="Ollama address" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                <TextBox x:Name="UrlBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Ollama address" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Row}">
                                <TextBlock Text="Model (a vision model such as qwen2.5vl:7b reads photos)" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Test and list models" Margin="8,0,0,0" Click="OnTestOllama" />
                                    <ComboBox x:Name="ModelBox" Style="{StaticResource FieldCombo}" IsEditable="True" AutomationProperties.Name="Ollama model" />
                                </DockPanel>
                                <TextBlock x:Name="TestStatus" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="MANUFACTURER PARTS MANAGER" Style="{StaticResource SectionText}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Library for new parts (created if it does not exist; blank for none)" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <TextBox x:Name="LibraryCode" Style="{StaticResource FieldBox}" AutomationProperties.Name="Library" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Language code for descriptions and class names (blank picks one from the archive)" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <TextBox x:Name="LanguageBox" Style="{StaticResource FieldBox}" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="Language code" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Copy the data sheet to this folder and link the copy (blank links the original file)" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseFolder" />
                                <TextBox x:Name="DatasheetFolder" Style="{StaticResource FieldBox}" AutomationProperties.Name="Data sheet folder" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}" Margin="0">
                            <TextBlock Text="Write an 'Imported from…' note to user data number (0 = don't write)" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <TextBox x:Name="SlotNote" Style="{StaticResource FieldBox}" Width="80" HorizontalAlignment="Left" AutomationProperties.Name="User data number for the import note" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="WHERE EACH VALUE IS SAVED" Style="{StaticResource SectionText}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="Pick the manufacturer part field that receives each value. Choose 'Not written' to leave a value out. Reference, manufacturer, class and circuits are always saved." />
                        <DataGrid x:Name="MapGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}" BorderBrush="{StaticResource BorderBrush}"
                                  Background="{StaticResource CardBrush}" RowBackground="{StaticResource CardBrush}"
                                  Height="300" SelectionMode="Single" AutomationProperties.Name="Value destinations">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Value" Binding="{Binding Label}" IsReadOnly="True" Width="*" />
                                <DataGridTemplateColumn Header="Saved to" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                      SelectedValue="{Binding TargetId, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ADVANCED" Style="{StaticResource SectionText}" />
                        <TextBlock x:Name="KeyStatus" Style="{StaticResource BodyText}" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Style="{StaticResource GhostButton}" Content="Open settings file" Click="OnOpenFile"
                                    ToolTip="Pin a circuit kind to a circuit type with CircuitTypeKeyCodes, for example {&quot;Coil&quot;:&quot;COIL&quot;}." />
                            <Button Style="{StaticResource GhostButton}" Content="Open log folder" Click="OnOpenLogs" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
