<Window x:Class="DataSheetMfgPartsImport.UI.ImporterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DataSheetMfgPartsImport.UI.ViewModels"
        xmlns:conv="clr-namespace:DataSheetMfgPartsImport.UI.Converters"
        Title="Data Sheet MFG Parts Import"
        Icon="/DataSheetMfgPartsImport;component/Icons/import32.png"
        Width="1240" Height="820" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DataSheetMfgPartsImport;component/UI/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:ConfidenceToShapeConverter x:Key="ConfidenceShape" />
            <conv:ConfidenceToTipConverter x:Key="ConfidenceTip" />
            <conv:ConfidenceToBrushConverter x:Key="ConfidenceBrush" />
            <conv:CardStateToBrushConverter x:Key="StateBrush" />
            <conv:KindToBrushConverter x:Key="KindBrush" />
            <conv:BoolToVisibilityConverter x:Key="Visible" />
            <conv:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <conv:PercentToWidthConverter x:Key="PercentWidth" />

            <!-- ============ One editable field ============ -->
            <DataTemplate x:Key="FieldTemplate" DataType="{x:Type vm:FieldViewModel}">
                <StackPanel Margin="0,0,14,12">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Width" Value="196" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Field}" Value="Description">
                                    <Setter Property="Width" Value="406" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Field}" Value="OtherSpecifications">
                                    <Setter Property="Width" Value="406" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="{Binding Confidence, Converter={StaticResource ConfidenceShape}}"
                                   Foreground="{Binding Confidence, Converter={StaticResource ConfidenceBrush}}"
                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"
                                   ToolTip="{Binding Confidence, Converter={StaticResource ConfidenceTip}}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Style="{StaticResource LabelText}" />
                        <TextBlock Style="{StaticResource LabelText}">
                            <Run Text="{Binding Label, Mode=OneWay}" />
                            <Run Foreground="{StaticResource DangerBrush}">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value="" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Required}" Value="True">
                                                <Setter Property="Text" Value=" *" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                    </DockPanel>
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding Tooltip}"
                             AutomationProperties.Name="{Binding Label}"
                             AutomationProperties.HelpText="{Binding ConfidenceText}" />
                </StackPanel>
            </DataTemplate>

            <!-- ============ One circuit row ============ -->
            <DataTemplate x:Key="CircuitTemplate" DataType="{x:Type vm:CircuitViewModel}">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="2*" MinWidth="180" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Style="{StaticResource FieldCombo}" Margin="0,0,8,0"
                              ItemsSource="{x:Static vm:CircuitViewModel.Kinds}" SelectedItem="{Binding Kind}"
                              AutomationProperties.Name="Circuit kind" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,8,0" FontFamily="{StaticResource MonoFont}"
                             Text="{Binding Terminals, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Terminal marks, comma separated (e.g. A1, A2)"
                             AutomationProperties.Name="Terminal marks" />
                    <ComboBox Grid.Column="2" Margin="0,0,8,0" ItemsSource="{Binding Types}" SelectedItem="{Binding CircuitType}"
                              DisplayMemberPath="Display" IsTextSearchEnabled="True" TextSearch.TextPath="Display"
                              IsEditable="True" Text="{Binding KeyCodeText, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="Circuit type">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource FieldCombo}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasType}" Value="False">
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                        <Setter Property="ToolTip" Value="Choose the SOLIDWORKS Electrical circuit type, or type its key code" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <Border Grid.Column="3" Style="{StaticResource Badge}" ToolTip="{Binding Source}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding OriginText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                    <Button Grid.Column="4" Style="{StaticResource GhostButton}" Content="Remove" Foreground="{StaticResource DangerBrush}"
                            Command="{Binding DataContext.RemoveCircuitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" AutomationProperties.Name="Remove circuit" />
                </Grid>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="WrapPanelTemplate">
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>

            <!-- ============ Part card ============ -->
            <DataTemplate x:Key="PartCardTemplate" DataType="{x:Type vm:PartCardViewModel}">
                <Border CornerRadius="8" Margin="0,0,0,12" Background="{StaticResource CardBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="Opacity" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="Opacity" Value="0.72" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- state accent bar -->
                        <Border Grid.RowSpan="3" CornerRadius="8,0,0,8" Background="{Binding State, Converter={StaticResource StateBrush}}" />

                        <!-- header -->
                        <Grid Grid.Column="1" Margin="14,14,14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource SelectCheck}" IsChecked="{Binding IsSelected}" Margin="0,2,14,0" VerticalAlignment="Top"
                                      AutomationProperties.Name="{Binding Title, StringFormat=Include {0}}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,8" />
                                <WrapPanel>
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Text="{Binding CategoryText}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Background="{StaticResource SurfaceBrush}" ToolTip="How this reference was found">
                                        <TextBlock Text="{Binding Origin}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,10,0"
                                                ToolTip="Share of fields filled">
                                        <Border Width="80" Height="6" CornerRadius="3" Background="{StaticResource BorderBrush}" VerticalAlignment="Center">
                                            <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource AccentBrush}"
                                                    Width="{Binding CoveragePercent, Converter={StaticResource PercentWidth}, ConverterParameter=80}" />
                                        </Border>
                                        <TextBlock Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center">
                                            <Run Text="{Binding FoundCount, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding FieldCount, Mode=OneWay}" /><Run Text=" fields" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SourceFileName}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="260" ToolTip="{Binding SourceFile}" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Style="{StaticResource Badge}" Background="Transparent" BorderBrush="{Binding State, Converter={StaticResource StateBrush}}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding State, Converter={StaticResource StateBrush}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleExpandCommand}" Margin="4,0,0,0"
                                        AutomationProperties.Name="Show or hide details">
                                    <Button.Content>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Details ▾" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="Hide ▴" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- duplicate / problems / result strip -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="14,0,14,10">
                            <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,6" Background="{StaticResource WarningSoftBrush}"
                                    Visibility="{Binding IsDuplicate, Converter={StaticResource Visible}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DuplicateText}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                                    <Border Grid.Column="1" Background="{StaticResource BorderBrush}" CornerRadius="7" Padding="1"
                                            AutomationProperties.Name="Existing part handling">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" Content="Skip" IsChecked="{Binding Skip}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="Overwrite" IsChecked="{Binding Overwrite}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border CornerRadius="6" Padding="10,6" Background="{StaticResource DangerSoftBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="NeedsAttention">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ProblemText}" Style="{StaticResource BodyText}" Foreground="{StaticResource DangerBrush}" />
                            </Border>
                            <Border CornerRadius="6" Padding="10,6" Background="{StaticResource SurfaceBrush}"
                                    Visibility="{Binding ResultMessage, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ResultMessage}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                               Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                                    <TextBlock Text="{Binding ResultDetails}" Style="{StaticResource MutedText}"
                                               Visibility="{Binding ResultDetails, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- details -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="14,0,14,14"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />

                            <!-- class -->
                            <TextBlock Text="CLASS" Style="{StaticResource SectionText}" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="460" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"
                                          DisplayMemberPath="Path" IsTextSearchEnabled="True" TextSearch.TextPath="Path"
                                          AutomationProperties.Name="Manufacturer part class" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="Confirm"
                                        Command="{Binding ConfirmClassCommand}" AutomationProperties.Name="Confirm suggested class" />
                                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding ClassStatusText}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ClassConfirmed}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="IDENTITY" Style="{StaticResource SectionText}" />
                            <ItemsControl ItemsSource="{Binding IdentityFields}" ItemTemplate="{StaticResource FieldTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />

                            <TextBlock Text="ELECTRICAL RATINGS" Style="{StaticResource SectionText}" Margin="0,4,0,8" />
                            <ItemsControl ItemsSource="{Binding RatingFields}" ItemTemplate="{StaticResource FieldTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />

                            <TextBlock Text="DIMENSIONS &amp; WEIGHT" Style="{StaticResource SectionText}" Margin="0,4,0,8" />
                            <ItemsControl ItemsSource="{Binding DimensionFields}" ItemTemplate="{StaticResource FieldTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />

                            <TextBlock Text="COMMERCIAL &amp; OTHER" Style="{StaticResource SectionText}" Margin="0,4,0,8" />
                            <ItemsControl ItemsSource="{Binding OtherFields}" ItemTemplate="{StaticResource FieldTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />

                            <DockPanel Margin="0,4,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="+ Add circuit" Command="{Binding AddCircuitCommand}" />
                                <TextBlock Text="CIRCUITS &amp; TERMINALS" Style="{StaticResource SectionText}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="2*" MinWidth="180" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kind" Style="{StaticResource LabelText}" />
                                <TextBlock Grid.Column="1" Text="Terminal marks" Style="{StaticResource LabelText}" />
                                <TextBlock Grid.Column="2" Text="Circuit type (SOLIDWORKS Electrical)" Style="{StaticResource LabelText}" />
                                <TextBlock Grid.Column="3" Text="Origin" Style="{StaticResource LabelText}" />
                                <TextBlock Grid.Column="4" Text="" Width="58" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Circuits}" ItemTemplate="{StaticResource CircuitTemplate}" Focusable="False" />
                            <TextBlock Text="No circuits detected. Add them if the part has terminals." Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Circuits.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding BuildCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Root" Background="{StaticResource SurfaceBrush}" AllowDrop="True"
          DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header (SWEETs light header bar) ================= -->
        <Border Style="{StaticResource Header.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Style="{StaticResource Header.Icon}" Source="/DataSheetMfgPartsImport;component/Icons/import32.png" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Header.Overline}" Text="SWEETs · Import Tools" />
                    <TextBlock Style="{StaticResource Header.Title}" Text="Data Sheet MFG Parts Import" />
                    <TextBlock Style="{StaticResource Header.Subtitle}" Text="Add manufacturer parts to the library from a data sheet" />
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Chip}" Padding="10,4" Margin="0,0,10,0"
                        ToolTip="SOLIDWORKS Electrical connection">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Warning}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionLabel}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Ink}" />
                    </StackPanel>
                </Border>
                <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Content="Settings" Click="OnSettings"
                        VerticalAlignment="Center" AutomationProperties.Name="Open importer settings" />
            </Grid>
        </Border>

        <!-- ================= Result banner ================= -->
        <Border Grid.Row="1" Padding="20,10" Visibility="{Binding HasResultBanner, Converter={StaticResource Visible}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultKind}" Value="warning">
                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ResultKind}" Value="error">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Dismiss" Command="{Binding DismissBannerCommand}" />
                <TextBlock Text="{Binding ResultBanner}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13"
                           Foreground="{Binding ResultKind, Converter={StaticResource KindBrush}}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*" MinWidth="270" MaxWidth="370" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- == left rail == -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,6,8" Focusable="False">
                <StackPanel>
                    <!-- drop zone -->
                    <Border x:Name="DropZone" CornerRadius="10" Background="{StaticResource CardBrush}" Margin="0,0,0,12"
                            AutomationProperties.Name="Data sheet drop zone">
                        <Grid>
                            <Rectangle x:Name="DropOutline" RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="5 3"
                                       Stroke="{StaticResource BorderStrongBrush}" />
                            <StackPanel Margin="18,22" HorizontalAlignment="Center">
                                <Viewbox Width="40" Height="40" Margin="0,0,0,10">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{StaticResource AccentSoftBrush}" Data="M6,2 H14 L20,8 V22 H6 Z" />
                                        <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                              Data="M6,2 H14 L20,8 V22 H6 Z M14,2 V8 H20" />
                                        <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Data="M13,11 V18 M10,15.5 L13,18.5 L16,15.5" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Drop data sheets here (PDF or photo)" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13.5"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="One file can contain several parts" HorizontalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,2,0,12" />
                                <Button Style="{StaticResource PrimaryButton}" Content="_Browse…" Command="{Binding BrowseCommand}" HorizontalAlignment="Center"
                                        ToolTip="Ctrl+O" AutomationProperties.Name="Browse for a data sheet" />
                                <TextBlock Text="Read locally on this PC · nothing is uploaded" HorizontalAlignment="Center" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- files -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasFiles, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="FILES" Style="{StaticResource SectionText}" />
                            <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8" ToolTip="{Binding Path}">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="11.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- steps -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PROGRESS" Style="{StaticResource SectionText}" />
                            <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StepViewModel}">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Ellipse Fill="{Binding State, Converter={StaticResource KindBrush}}" />
                                                <TextBlock Text="{Binding Number}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="11.5"
                                                           Visibility="{Binding Detail, Converter={StaticResource Visible}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- summary + coverage chart -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasParts, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="SUMMARY" Style="{StaticResource SectionText}" />
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding SelectedCount}" Style="{StaticResource MetricText}" />
                                    <TextBlock Text="Selected" Style="{StaticResource LabelText}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding ToWriteCount}" Style="{StaticResource MetricText}" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="Will be saved" Style="{StaticResource LabelText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding ConflictCount}" Style="{StaticResource MetricText}" Foreground="{StaticResource WarningBrush}" />
                                    <TextBlock Text="Already exist" Style="{StaticResource LabelText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding AttentionCount}" Style="{StaticResource MetricText}" Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Text="Need attention" Style="{StaticResource LabelText}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource LabelText}" Margin="0,4,0,8">
                                <Run Text="Field coverage · avg " /><Run Text="{Binding AverageCoverage, Mode=OneWay}" /><Run Text="%" />
                            </TextBlock>
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Parts}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PartCardViewModel}">
                                        <Grid Margin="0,0,0,6" ToolTip="{Binding Title}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="38" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{StaticResource BorderBrush}" VerticalAlignment="Center">
                                                <Border HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource AccentBrush}"
                                                        Width="{Binding CoveragePercent, Converter={StaticResource PercentWidth}, ConverterParameter=110}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5"
                                                       Foreground="{StaticResource TextMutedBrush}">
                                                <Run Text="{Binding CoveragePercent, Mode=OneWay}" /><Run Text="%" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- activity -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ACTIVITY" Style="{StaticResource SectionText}" />
                            <TextBlock Text="Nothing yet." Style="{StaticResource MutedText}"
                                       Visibility="{Binding Activity.Count, Converter={StaticResource Hidden}}" />
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Activity}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ActivityItem}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,0,0"
                                                           Fill="{Binding Kind, Converter={StaticResource KindBrush}}"
                                                           AutomationProperties.Name="{Binding KindLabel}" />
                                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- == parts == -->
            <Grid Grid.Column="1" Margin="10,16,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="Select all" Command="{Binding SelectAllCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Select none" Command="{Binding SelectNoneCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Clear" Command="{Binding ClearCommand}" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Detected parts" Style="{StaticResource TitleText}" />
                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="{Binding HasParts, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding Parts.Count}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- bulk class assignment bar -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10"
                        Visibility="{Binding HasParts, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Set class for all:" Style="{StaticResource LabelText}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AllClasses}"
                                  DisplayMemberPath="Path"
                                  SelectedItem="{Binding BulkClassCandidate, Mode=TwoWay}"
                                  IsEditable="True" IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Path"
                                  Style="{StaticResource FieldCombo}"
                                  ToolTip="Pick a class to apply to every part that has not yet had its class confirmed."
                                  AutomationProperties.Name="Class for all parts" />
                        <Button Grid.Column="2" Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Content="{Binding ApplyClassLabel}"
                                Command="{Binding ApplyClassToAllCommand}"
                                ToolTip="Applies the chosen class to every part without a confirmed class and marks them confirmed."
                                AutomationProperties.Name="Apply class to unconfirmed parts" />
                    </Grid>
                </Border>

                <!-- empty state -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="40" VerticalAlignment="Top"
                        Visibility="{Binding HasParts, Converter={StaticResource Hidden}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                        <TextBlock Text="No parts yet" Style="{StaticResource TitleText}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center"
                                   Text="Add a manufacturer data sheet: a PDF, or a photo when the local AI model is on. It is read on this PC, the reference, manufacturer, ratings, dimensions and circuits are extracted, and each part is shown here for review before anything is saved to the library." />
                        <UniformGrid Columns="3" Margin="0,22,0,0">
                            <StackPanel Margin="6">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Found with label" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Margin="6">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource WarningBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Inferred — check" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Margin="6">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Edited by you" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Virtualized: catalogs can produce hundreds of cards -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource PartCardTemplate}" Focusable="False"
                              Visibility="{Binding HasParts, Converter={StaticResource Visible}}" AutomationProperties.Name="Detected parts"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsPresenter Margin="0,0,0,8" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Grid>

        <!-- ================= Footer ================= -->
        <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding Progress}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" AutomationProperties.Name="Progress" />
                <Grid Grid.Row="1" Margin="20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding BuildHint}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel operation" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Close" IsCancel="True" Click="OnClose" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding BuildButtonText}" Command="{Binding BuildCommand}"
                                ToolTip="Ctrl+Enter" AutomationProperties.Name="Save the selected manufacturer parts to the library" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
