<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Line Style Editor uses the shared SWEETs theme (src\SWEETs.UI\Theme.xaml). Change colours and styles there, not here. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SWEETs.UI;component/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Line Style Editor only: its grids edit cells in place and size rows for inline editors. -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="RowHeight" Value="30" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="SelectionUnit" Value="Cell" />
    </Style>
</ResourceDictionary>
