<Window x:Class="SWEETs.SweLineStyles.AddIn.UI.BackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SWEETs.SweLineStyles.AddIn.UI"
        Title="Backups" Width="720" Height="520" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="#F5F6F8" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SWEETs.SweLineStyles.AddIn;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:HasValueToVisibility x:Key="HasValueToVis" />
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Header.Bar}">
        <StackPanel>
            <TextBlock Text="SWEETs · Line Style Editor" Style="{StaticResource Header.Overline}" />
            <TextBlock Text="Backups" Style="{StaticResource Header.Title}" />
            <TextBlock x:Name="RootText" Style="{StaticResource Header.Subtitle}" />
        </StackPanel>
    </Border>
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <TextBlock x:Name="EmptyText" Text="No backups yet. A backup is made before every save." Style="{StaticResource Text.Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ListBox x:Name="BackupList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource CardListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnRestore" AutomationProperties.Name="Backups">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="12,9">
                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Visibility="{Binding Reason, Converter={StaticResource HasValueToVis}}" />
                            <TextBlock Text="{Binding Files}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Restore selected" Style="{StaticResource Btn.Primary}" Click="OnRestore" />
            </StackPanel>
            <Button Content="Open backup folder" Style="{StaticResource Btn.Ghost}" Click="OnOpenFolder" HorizontalAlignment="Left" />
        </DockPanel>
    </Grid>
    </DockPanel>
</Window>
