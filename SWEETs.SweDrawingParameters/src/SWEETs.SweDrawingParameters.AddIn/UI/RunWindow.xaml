<Window x:Class="SWEETs.SweDrawingParameters.AddIn.UI.RunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SWEETs.SweDrawingParameters.AddIn.UI"
        xmlns:vm="clr-namespace:SWEETs.SweDrawingParameters.AddIn.UI.ViewModels"
        Title="Updating drawing parameters"
        Width="860" Height="560" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="#F5F6F8" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SWEETs.SweDrawingParameters.AddIn;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:BoolToVisibility x:Key="BoolToVis" />

            <DataTemplate x:Key="StatePill" DataType="{x:Type vm:DrawingRowViewModel}">
                <Border x:Name="Pill" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                        Background="{StaticResource SurfaceAlt}" ToolTip="{Binding Detail}">
                    <TextBlock x:Name="Txt" Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" />
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Verified">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource SuccessSoft}" />
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Success}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Working">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentSoft}" />
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Accent}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding State}" Value="Failed">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource DangerSoft}" />
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Danger}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Skipped">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSoft}" />
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Warning}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="ColHeader" TargetType="GridViewColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource InkSubtle}" />
                <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            </Style>
            <Style x:Key="Row" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0,5" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="#EEF0F3" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Header (SWEETs light header bar) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Header.Bar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Header.Overline}" Text="SWEETs · Update Project Drawing Parameters" />
                    <TextBlock Style="{StaticResource Header.Title}" Text="Updating drawing parameters" />
                    <TextBlock Style="{StaticResource Header.Subtitle}"><Run Text="Project " /><Run Text="{Binding ProjectName, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="VERIFIED" Style="{StaticResource Text.Overline}" />
                    <TextBlock Style="{StaticResource Text.Kpi}" Foreground="{StaticResource Success}" Text="{Binding VerifiedCount}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ISSUES" Style="{StaticResource Text.Overline}" />
                    <TextBlock Style="{StaticResource Text.Kpi}" Foreground="{StaticResource Danger}" Text="{Binding ProblemCount}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Banner -->
            <Border Grid.Row="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentSoft}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BannerKind}" Value="Success">
                                <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BannerKind}" Value="Warning">
                                <Setter Property="Background" Value="{StaticResource WarningSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BannerKind}" Value="Error">
                                <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding BannerText}" Style="{StaticResource Text.Body}" />
            </Border>

            <!-- Drawings -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <ListView ItemsSource="{Binding Rows}" BorderThickness="0" ItemContainerStyle="{StaticResource Row}" SelectionMode="Single">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ColHeader}">
                            <GridViewColumn Header="DRAWING" Width="250">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding TypeLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Name, Mode=OneWay}" /></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="SNAP" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding SnapText}" FontFamily="{StaticResource MonoFont}" FontSize="12" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="GRID" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding GridText}" FontFamily="{StaticResource MonoFont}" FontSize="12" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="GRID ZONE" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding ZoneText}" FontFamily="{StaticResource MonoFont}" FontSize="12" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="STATUS" Width="120" CellTemplate="{StaticResource StatePill}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ProgressText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Backups" Style="{StaticResource Btn.Ghost}" Command="{Binding OpenBackupsCommand}" />
                    <Button Content="Log" Style="{StaticResource Btn.Ghost}" Command="{Binding OpenLogCommand}" Margin="4,0,12,0" />
                    <Button Content="Cancel run" Style="{StaticResource Btn.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Close" Style="{StaticResource Btn.Primary}" Click="OnClose" MinWidth="110"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
