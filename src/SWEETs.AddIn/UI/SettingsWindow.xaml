<Window x:Class="SWEETs.AddIn.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SWEETs Settings"
        Width="640" SizeToContent="Height" MinWidth="560" MaxHeight="860" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="#F5F6F8" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SWEETs.AddIn;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One tool: switch, caption, description, load state -->
            <DataTemplate x:Key="ToolRow">
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,12,0"
                              AutomationProperties.Name="{Binding Caption}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="Pill" Style="{StaticResource Chip}" VerticalAlignment="Top" Margin="12,0,0,0">
                        <TextBlock x:Name="Txt" Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" />
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Loaded">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource SuccessSoft}" />
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Success}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Failed">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource DangerSoft}" />
                        <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Danger}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Header (SWEETs light header bar) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Header.Bar}">
            <StackPanel Orientation="Horizontal">
                <Image Style="{StaticResource Header.Icon}" Source="pack://application:,,,/SWEETs.AddIn;component/Resources/sweets-32.png" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SWEETs · Settings" Style="{StaticResource Header.Overline}" />
                    <TextBlock Text="SWEETs Settings" Style="{StaticResource Header.Title}" />
                    <TextBlock Text="Tools shown on the SWEETs tab" Style="{StaticResource Header.Subtitle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DockPanel Margin="24,16,24,24">

        <!-- Footer -->
        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <Button Content="Open log folder" Style="{StaticResource Btn.Ghost}" Margin="12,0,0,0" Click="OnOpenLogs" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" IsCancel="True" MinWidth="88" />
                <Button Content="Save" Style="{StaticResource Btn.Primary}" IsDefault="True" MinWidth="88" Margin="8,0,0,0" Click="OnSave" />
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>
            <!-- One card per ribbon group (Drawing Tools, Import Tools, Export Tools, Project Tools), in tab order. -->
            <ItemsControl x:Name="GroupsList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Overline}" Margin="0,8,0,0" />
                                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ToolRow}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,0,0,0"
                       Text="Saving rebuilds the SWEETs tab. If a button does not appear or disappear, restart SOLIDWORKS Electrical." />
        </StackPanel>
        </ScrollViewer>
        </DockPanel>
    </DockPanel>
</Window>
