<Window x:Class="SWEETs.SwePdfSchematic.AddIn.UI.PartsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SWEETs.SwePdfSchematic.AddIn.UI.ViewModels"
        Title="Manufacturer parts" Width="980" Height="520" MinWidth="760" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SWEETs.SwePdfSchematic.AddIn;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Header.Bar}">
            <StackPanel>
                <TextBlock Text="SWEETs · PDF to Schematic" Style="{StaticResource Header.Overline}" />
                <TextBlock x:Name="Heading" Style="{StaticResource Header.Title}" />
                <TextBlock x:Name="Facts" Style="{StaticResource Header.Subtitle}" Margin="0,4,0,0" />
                <CheckBox x:Name="IncludeItem" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,14,20,0" Padding="0">
            <DataGrid x:Name="PartsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Border}" BorderThickness="0" Background="Transparent"
                      RowBackground="Transparent" SelectionMode="Single" SelectionUnit="FullRow" AutomationProperties.Name="Parts">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Use" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="44" />
                    <DataGridCheckBoxColumn Header="Circuits" Binding="{Binding CarriesCircuits, UpdateSourceTrigger=PropertyChanged}" Width="62" />
                    <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer, UpdateSourceTrigger=LostFocus}" Width="130" />
                    <DataGridTextColumn Header="Reference" Binding="{Binding Reference, UpdateSourceTrigger=LostFocus}" Width="170" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=LostFocus}" Width="*" />
                    <DataGridTextColumn Header="Article no." Binding="{Binding ArticleNumber, UpdateSourceTrigger=LostFocus}" Width="100" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="50" />
                    <DataGridTemplateColumn Header="Catalog" Width="110" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:PartRowViewModel}">
                                <TextBlock Text="{Binding CatalogText}" Foreground="{Binding CatalogBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           ToolTip="{Binding CatalogNote}" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Source" Binding="{Binding Origin}" Width="110" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Padding="20,12" Margin="0,14,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" IsCancel="True" Margin="0,0,8,0" />
                    <Button Content="Save" Style="{StaticResource Btn.Primary}" IsDefault="True" Click="OnOk" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add part" Style="{StaticResource Btn.Ghost}" Click="OnAdd" Margin="-8,0,0,0" />
                    <Button Content="Remove" Style="{StaticResource Btn.Danger}" Click="OnRemove" />
                    <Button x:Name="CheckButton" Content="Check catalog" Style="{StaticResource Btn.Ghost}" Click="OnCheck"
                            ToolTip="Look the parts up in the SOLIDWORKS Electrical manufacturer part catalog" />
                    <TextBlock x:Name="Hint" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
