<Window x:Class="SWEETs.SwePdfSchematic.AddIn.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SWEETs.SwePdfSchematic.AddIn.UI"
        xmlns:ctl="clr-namespace:SWEETs.SwePdfSchematic.AddIn.UI.Controls"
        xmlns:vm="clr-namespace:SWEETs.SwePdfSchematic.AddIn.UI.ViewModels"
        Title="PDF to Schematic — SOLIDWORKS Electrical"
        Width="1360" Height="880" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="pack://application:,,,/SWEETs.SwePdfSchematic.AddIn;component/Resources/ribbon-icon.png"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SWEETs.SwePdfSchematic.AddIn;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:BoolToVisibility x:Key="BoolVis" />
            <ui:EnumEquals x:Key="EnumEq" />
            <ui:EnumToVisibility x:Key="EnumVis" />
            <ui:HasValueToVisibility x:Key="HasVis" />
            <ui:MillimetresText x:Key="Mm" />

            <!-- KPI tile -->
            <DataTemplate x:Key="KpiTile" DataType="{x:Type vm:Kpi}">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Overline}" />
                        <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Kpi}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Review card -->
            <DataTemplate x:Key="SymbolCard" DataType="{x:Type vm:SymbolCardViewModel}">
                <Grid AutomationProperties.Name="{Binding Tag}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding StateBrush}" CornerRadius="7,0,0,7" />
                    <StackPanel Grid.Column="1" Margin="12,10,12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Tag}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding KindText}" FontSize="11.5" Foreground="{StaticResource InkMuted}" />
                                </Border>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Chip}" Background="{Binding StateSoftBrush}">
                                <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding StateBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SWE symbol" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SweSymbol}" Margin="8,0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding SweSymbol}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Recognition confidence">
                                <ProgressBar Width="56" Height="5" Maximum="1" Value="{Binding Confidence, Mode=OneWay}" Foreground="{Binding ConfidenceBrush}"
                                             Background="{StaticResource SurfaceAlt}" BorderThickness="0" />
                                <TextBlock Text="{Binding ConfidenceText}" Margin="6,0,0,0" FontSize="11.5" Foreground="{StaticResource InkMuted}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,6,0,0" ToolTip="{Binding PartsTooltip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Parts" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding PartsLine}" Margin="8,0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource Chip}" Visibility="{Binding HasPartsBadge, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding PartsBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding PartsBadgeBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}" />

                        <WrapPanel Orientation="Horizontal" Margin="-8,6,0,0">
                            <Button Content="Confirm" Style="{StaticResource Btn.Ghost}"
                                    Command="{Binding DataContext.ConfirmCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    ToolTip="Accept this mapping (Ctrl+Enter)" />
                            <Button Content="Change symbol…" Style="{StaticResource Btn.Ghost}"
                                    Command="{Binding DataContext.MapCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    ToolTip="Pick the SOLIDWORKS Electrical library symbol (Ctrl+M)" />
                            <Button Content="Parts…" Style="{StaticResource Btn.Ghost}"
                                    Command="{Binding DataContext.PartsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    ToolTip="Manufacturer parts of this component, read from the PDF's bill of materials (Ctrl+P)" />
                            <Button Content="Ignore" Style="{StaticResource Btn.Danger}"
                                    Command="{Binding DataContext.IgnoreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    ToolTip="Leave this out of the build (Delete). Click again to restore." />
                            <Button Content="{Binding CombineText}" Style="{StaticResource Btn.Ghost}"
                                    Visibility="{Binding CanCombine, Converter={StaticResource BoolVis}}"
                                    Command="{Binding DataContext.CombineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    ToolTip="Merge the poles of this device into one multi-circuit symbol (e.g. a 4-pole fuse disconnector)" />
                            <Button Content="Split poles" Style="{StaticResource Btn.Ghost}"
                                    Visibility="{Binding IsCombined, Converter={StaticResource BoolVis}}"
                                    Command="{Binding DataContext.SplitCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    ToolTip="Separate this combined symbol back into its poles" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+Return" Command="{Binding ConfirmCommand}" />
        <KeyBinding Gesture="Ctrl+M" Command="{Binding MapCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding PartsCommand}" />
        <KeyBinding Key="Delete" Command="{Binding IgnoreCommand}" />
    </Window.InputBindings>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ================= Header (SWEETs light header bar) ================= -->
        <Border Style="{StaticResource Header.Bar}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Style="{StaticResource Header.Icon}" Source="pack://application:,,,/SWEETs.SwePdfSchematic.AddIn;component/Resources/ribbon-icon.png" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SWEETs · Import Tools" Style="{StaticResource Header.Overline}" />
                        <TextBlock Text="PDF to Schematic" Style="{StaticResource Header.Title}" />
                        <TextBlock Text="Build a SOLIDWORKS Electrical project from a schematic PDF" Style="{StaticResource Header.Subtitle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" Visibility="{Binding HasFile, Converter={StaticResource BoolVis}}" Margin="0,0,10,0" MaxWidth="420">
                        <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{StaticResource InkMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PdfPath}" />
                    </Border>
                    <Button Content="Open PDF…" Style="{StaticResource Btn.Secondary}" Command="{Binding OpenCommand}" ToolTip="Ctrl+O" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Step rail -->
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Steps" Style="{StaticResource Text.Overline}" Margin="10,0,0,8" />
                        <RadioButton Style="{StaticResource StepItem}" Tag="1" Content="Source PDF" GroupName="steps"
                                     IsChecked="{Binding CurrentStep, Mode=TwoWay, Converter={StaticResource EnumEq}, ConverterParameter=Source}" />
                        <RadioButton Style="{StaticResource StepItem}" Tag="2" Content="Analysis" GroupName="steps"
                                     IsChecked="{Binding CurrentStep, Mode=TwoWay, Converter={StaticResource EnumEq}, ConverterParameter=Analyze}"
                                     IsEnabled="{Binding HasDocument}" />
                        <RadioButton Style="{StaticResource StepItem}" Tag="3" Content="Review symbols" GroupName="steps"
                                     IsChecked="{Binding CurrentStep, Mode=TwoWay, Converter={StaticResource EnumEq}, ConverterParameter=Review}"
                                     IsEnabled="{Binding HasDocument}" />
                        <RadioButton Style="{StaticResource StepItem}" Tag="4" Content="Build project" GroupName="steps"
                                     IsChecked="{Binding CurrentStep, Mode=TwoWay, Converter={StaticResource EnumEq}, ConverterParameter=Build}"
                                     IsEnabled="{Binding ReadyToBuild}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="10,0">
                        <TextBlock Text="{Binding EnvironmentSummary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <Button Content="Open log folder" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Margin="-8,6,0,0" Command="{Binding OpenLogFolderCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1" Margin="24,20,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{Binding StepHint}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- ===== 1. Source ===== -->
                <Grid Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource EnumVis}, ConverterParameter=Source}">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Width="640">
                        <Grid>
                            <Rectangle Fill="{StaticResource Surface}" Stroke="{StaticResource BorderStrong}" StrokeThickness="1.5" StrokeDashArray="5 4" RadiusX="10" RadiusY="10" />
                            <StackPanel HorizontalAlignment="Center" Margin="32">
                                <Path HorizontalAlignment="Center" Width="40" Height="48" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.8"
                                      Data="M4,1 H22 L32,11 V43 H4 Z M22,1 V11 H32 M10,22 H16 V30 H26 M16,26 H22" />
                                <TextBlock Text="Open a schematic PDF" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,14,0,4" />
                                <TextBlock Text="Drop a file here, or browse. Vector PDFs exported from AutoCAD Electrical, EPLAN, SOLIDWORKS Electrical and similar tools are supported."
                                           Style="{StaticResource Text.Muted}" TextAlignment="Center" MaxWidth="440" />
                                <Button Content="Browse for PDF…" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Center" Margin="0,18,0,0" Command="{Binding OpenCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasFile, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Current file" Style="{StaticResource Text.Overline}" />
                                <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding FileFacts}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Background="{StaticResource SurfaceAlt}" BorderThickness="0">
                            <StackPanel>
                                <TextBlock Text="How it works" Style="{StaticResource Text.Overline}" />
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0">
                                    The PDF is read on this computer. Wires, symbols, device tags, cross-references and title-block data are detected,
                                    you confirm which library symbol each shape becomes, and a new project is built from your template.
                                    Every confirmation is remembered, so the next import needs less review.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ===== 2. Analyze ===== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentStep, Converter={StaticResource EnumVis}, ConverterParameter=Analyze}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource Btn.Ghost}" Command="{Binding CancelCommand}" />
                                    <TextBlock Text="{Binding ProgressStage}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding AnalyzeFraction, Mode=OneWay}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Kpis}" ItemTemplate="{StaticResource KpiTile}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Grid Margin="0,4,0,0" Visibility="{Binding HasDocument, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Review status chart -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Review status" Style="{StaticResource Text.Subtitle}" />
                                    <TextBlock Text="{Binding ReviewSummary}" Style="{StaticResource Text.Caption}" Margin="0,2,0,12" />
                                    <ItemsControl ItemsSource="{Binding StateBars}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:Bar}">
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="44" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                                    <ProgressBar Grid.Column="1" Height="12" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Foreground="{Binding Fill}"
                                                                 Background="{StaticResource SurfaceAlt}" BorderThickness="0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Text}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Ink}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Continue to review" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                            Command="{Binding GoToStepCommand}" CommandParameter="Review" />
                                </StackPanel>
                            </Border>

                            <!-- Captured documentation -->
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Captured documentation" Style="{StaticResource Text.Subtitle}" />
                                    <TextBlock Text="From the title block; written to the project and the build log." Style="{StaticResource Text.Caption}" Margin="0,2,0,12" />
                                    <ItemsControl ItemsSource="{Binding Documentation}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:KeyValue}">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Body}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Pages to import -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="Schematics only" Style="{StaticResource Btn.Ghost}" Command="{Binding IncludeSchematicsCommand}"
                                                ToolTip="Import every schematic page; skip reports, lists and layouts" />
                                        <Button Content="None" Style="{StaticResource Btn.Ghost}" Command="{Binding ExcludeAllPagesCommand}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Pages to import" Style="{StaticResource Text.Subtitle}" />
                                        <TextBlock Text="{Binding PageSelectionSummary}" Style="{StaticResource Text.Caption}" Margin="0,2,0,10" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding PageRows}" AutomationProperties.Name="Pages to import">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PageRowViewModel}">
                                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center"
                                                                  AutomationProperties.Name="{Binding Label}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                                        <Border Grid.Column="2" Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding KindText}" FontSize="11.5" Foreground="{Binding KindBrush}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding Title}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Facts}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Background="{StaticResource WarningSoft}" BorderBrush="#F2D3A8"
                                Visibility="{Binding HasWarnings, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Things to check" Style="{StaticResource Text.Subtitle}" Foreground="{StaticResource Warning}" />
                                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='•  {0}'}" Style="{StaticResource Text.Body}" Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 3. Review ===== -->
                <Grid Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource EnumVis}, ConverterParameter=Review}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="12,8">
                                <Button DockPanel.Dock="Right" Content="Fit (F)" Style="{StaticResource Btn.Ghost}" Click="OnFit" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Success}" /><TextBlock Text="Confirmed" Style="{StaticResource Text.Caption}" Margin="4,0,10,0" />
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Warning}" /><TextBlock Text="Review" Style="{StaticResource Text.Caption}" Margin="4,0,10,0" />
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Danger}" /><TextBlock Text="Unmapped" Style="{StaticResource Text.Caption}" Margin="4,0,10,0" />
                                    <Ellipse Width="8" Height="8" Stroke="{StaticResource Accent}" StrokeThickness="1.5" /><TextBlock Text="Off-page link" Style="{StaticResource Text.Caption}" Margin="4,0,0,0" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Pages">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PageItem}">
                                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Badge}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <ctl:SchematicCanvas x:Name="PageCanvas" Grid.Row="1"
                                                 Page="{Binding SelectedPage.Analysis}"
                                                 Cards="{Binding PageCards}"
                                                 SelectedCard="{Binding SelectedSymbol, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Top">
                            <Border Background="{StaticResource SurfaceAlt}" CornerRadius="7" Padding="2" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="Needs attention" GroupName="filter"
                                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=NeedsAttention}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Confirmed" GroupName="filter"
                                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Confirmed}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Ignored" GroupName="filter"
                                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Ignored}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="All" GroupName="filter"
                                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=All}" />
                                </StackPanel>
                            </Border>
                            <DockPanel Margin="0,10,0,10">
                                <Button DockPanel.Dock="Right" Content="Confirm all ≥ 70%" Style="{StaticResource Btn.Ghost}" Command="{Binding ConfirmHighConfidenceCommand}" />
                                <TextBlock Text="{Binding ReviewSummary}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                                    Visibility="{Binding HasMultiSelection, Converter={StaticResource BoolVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{Binding CombineSelectionText}" Style="{StaticResource Btn.Primary}"
                                            Command="{Binding CombineCommand}" ToolTip="Merge the selected symbols (same page) into one multi-circuit symbol" />
                                    <TextBlock Text="Selected symbols can be combined into one library symbol." Style="{StaticResource Text.Caption}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Continue to build" Style="{StaticResource Btn.Primary}" Command="{Binding ContinueToBuildCommand}" />
                                <TextBlock Text="Map or ignore every symbol to continue." Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                           Visibility="{Binding ReadyToBuild, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />
                            </DockPanel>
                        </Border>

                        <Grid>
                            <ListBox x:Name="CardList" ItemsSource="{Binding CardsView}" SelectedItem="{Binding SelectedSymbol}" SelectionMode="Extended"
                                     ItemTemplate="{StaticResource SymbolCard}" ItemContainerStyle="{StaticResource CardListItem}"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                                     AutomationProperties.Name="Detected symbols" SelectionChanged="OnCardSelected">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2,10,0,8">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Overline}" />
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" Style="{StaticResource Text.Overline}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                            </ListBox>
                            <TextBlock Text="Nothing here — try another filter." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Items.Count, ElementName=CardList, Converter={StaticResource HasVis}, ConverterParameter=Invert}" />
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- ===== 4. Build ===== -->
                <Grid Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource EnumVis}, ConverterParameter=Build}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="New project" Style="{StaticResource Text.Subtitle}" />
                                    <TextBlock Text="Project name" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Project name" />
                                    <TextBlock Text="Project template" Style="{StaticResource FieldLabel}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource Btn.Ghost}" Margin="4,0,-8,0"
                                                Command="{Binding RefreshTemplatesCommand}" ToolTip="List the SOLIDWORKS Electrical project templates again" />
                                        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" IsEditable="True"
                                                  Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" TextSearch.TextPath="Name"
                                                  AutomationProperties.Name="Project template" ToolTip="SOLIDWORKS Electrical project templates; a name can also be typed">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" />
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock Text="{Binding TemplateFolderText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="The template archive below is used instead of the selected template. Clear it to use the template."
                                               Style="{StaticResource Text.Caption}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding UsingArchive, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Text="…or template archive (.tewzip)" Style="{StaticResource FieldLabel}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0" Command="{Binding BrowseTemplateCommand}" />
                                        <TextBox Text="{Binding TemplateArchivePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Template archive path" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Placement" Style="{StaticResource Text.Subtitle}" />
                                    <TextBlock Text="Unit of measure" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Millimetres" GroupName="units" IsChecked="{Binding UseMillimeters, Mode=TwoWay}" Margin="0,0,16,0" />
                                        <RadioButton Content="Inches" GroupName="units" IsChecked="{Binding UseInches, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock Text="Must match the template's drawing units (ANSI templates are usually inches). Set automatically when a template is picked."
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding DrawingAreaLabel}" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="90" Text="{Binding SheetWidth, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Drawing area width" />
                                        <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource InkMuted}" />
                                        <TextBox Width="90" Text="{Binding SheetHeight, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Drawing area height" />
                                    </StackPanel>
                                    <TextBlock Text="Grid snap" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding GridOptions}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                              SelectedValue="{Binding GridSnap}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Grid snap" />
                                    <CheckBox Content="Scale PDF frame to fit the drawing area" IsChecked="{Binding FitToSheet}" Margin="0,12,0,4" />
                                    <CheckBox Content="Attach the source PDF to the project" IsChecked="{Binding AttachSourcePdf}" />
                                    <CheckBox Content="Carry over the PDF wire numbers (wire style &quot;Imported&quot;, manual marks)" IsChecked="{Binding ApplyWireNumbers}" />
                                    <CheckBox Content="Pair origin-destination links (report)" IsChecked="{Binding CreateOriginDestination}" />
                                </StackPanel>
                            </Border>

                            <!-- Manufacturer parts -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Check catalog" Style="{StaticResource Btn.Ghost}" Margin="0,-6,-8,0"
                                                Command="{Binding CheckCatalogCommand}" ToolTip="Look the parts up in the SOLIDWORKS Electrical manufacturer part catalog again" />
                                        <TextBlock Text="Manufacturer parts" Style="{StaticResource Text.Subtitle}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding PartsSummary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                    <CheckBox Content="Assign the parts from the PDF's bill of materials to the components" IsChecked="{Binding AssignParts}" />
                                    <CheckBox Content="Create cables, rails, ducts and enclosure items listed without a symbol" IsChecked="{Binding CreateItemsWithoutSymbols}"
                                              IsEnabled="{Binding AssignParts}" Margin="0,4,0,0" />
                                    <TextBlock Text="Parts missing from the catalog are added to it (manufacturer, reference, description, article number)."
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                    <TextBlock Text="Items without a schematic symbol" Style="{StaticResource FieldLabel}"
                                               Visibility="{Binding HasBomItems, Converter={StaticResource BoolVis}}" />
                                    <ItemsControl ItemsSource="{Binding BomItems}" IsEnabled="{Binding CreateItemsWithoutSymbols}"
                                                  Visibility="{Binding HasBomItems, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Items without symbols">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:BomItemViewModel}">
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Include}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Mark}" />
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding Mark}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Text.Caption}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0">
                                                        <TextBlock Text="{Binding PartsSummary}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Content="Edit…" Style="{StaticResource Btn.Ghost}" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Background="{StaticResource SurfaceAlt}" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="Environment" Style="{StaticResource Text.Overline}" />
                                    <TextBlock Text="{Binding EnvironmentSummary}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                                    <ItemsControl ItemsSource="{Binding EnvironmentIssues}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Cancel" Style="{StaticResource Btn.Ghost}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                                        <Button Content="Simulate" Style="{StaticResource Btn.Secondary}" Command="{Binding SimulateCommand}" Margin="0,0,8,0"
                                                ToolTip="Run the whole build against an in-memory target. Nothing changes in SOLIDWORKS Electrical." />
                                        <Button Content="Build project" Style="{StaticResource Btn.Primary}" Command="{Binding BuildCommand}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Build" Style="{StaticResource Text.Subtitle}" />
                                        <TextBlock Text="{Binding BuildStage}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                </DockPanel>
                                <ProgressBar Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding BuildFraction, Mode=OneWay}" Margin="0,12,0,12" />
                                <ItemsControl ItemsSource="{Binding ResultKpis}" ItemTemplate="{StaticResource KpiTile}"
                                              Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="Activity" Style="{StaticResource Text.Overline}" Margin="0,4,0,6" />
                            </StackPanel>
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Background="{StaticResource SurfaceAlt}">
                                <ListBox x:Name="LogList" ItemsSource="{Binding Log}" BorderThickness="0" Background="Transparent" Padding="6"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Build log">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LogRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource InkSubtle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{Binding Brush}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,0">
                <TextBlock DockPanel.Dock="Right" Text="Ctrl+O open · Ctrl+Enter confirm · Ctrl+M change symbol · Del ignore · F fit" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
