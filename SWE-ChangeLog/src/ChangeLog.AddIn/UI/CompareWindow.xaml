<Window x:Class="ChangeLog.AddIn.UI.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ChangeLog.AddIn.UI.Controls"
        Title="{Binding Title}" Width="1280" Height="820" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#111827" Background="#F5F6F8">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ChangeLog.AddIn;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="DiffRowTemplate">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ActionPill}" VerticalAlignment="Top" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Kind}"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
    <!-- ============ Header (SWEETs light header bar) ============ -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Header.Bar}">
        <StackPanel>
            <TextBlock Style="{StaticResource Header.Overline}" Text="SWEETs · Change Log"/>
            <TextBlock Style="{StaticResource Header.Title}" Text="Compare"/>
            <TextBlock Style="{StaticResource Header.Subtitle}" Text="Visually compare two captures, or a capture and the live project"/>
        </StackPanel>
    </Border>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Capture pickers ============ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="FROM (older)" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Left}" DisplayMemberPath="Display"
                              AutomationProperties.Name="Compare from capture" Padding="6,5"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" Command="{Binding SwapCommand}" Margin="8,16,8,0"
                        ToolTip="Swap" AutomationProperties.Name="Swap captures">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8AB;"/>
                </Button>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="TO (newer)" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Right}" DisplayMemberPath="Display"
                              AutomationProperties.Name="Compare to capture" Padding="6,5"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding CompareCommand}" Content="Compare" Padding="18,6" IsDefault="True"/>
                    <Button Style="{StaticResource Btn}" Command="{Binding CaptureCommand}" Margin="8,0,0,0" Padding="12,6"
                            ToolTip="Re-reads the project and stores its current state for comparison">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE722;" Margin="0,0,6,0"/>
                            <TextBlock Text="Capture Changes now"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Summary ============ -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource Conv.Visible}}">
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ResultCaption}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Added"/>
                            <TextBlock Style="{StaticResource Text.Kpi}" Foreground="{StaticResource Brush.Added}" Text="{Binding Added, StringFormat=N0}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Edited"/>
                            <TextBlock Style="{StaticResource Text.Kpi}" Foreground="{StaticResource Brush.Edited}" Text="{Binding Edited, StringFormat=N0}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Removed"/>
                            <TextBlock Style="{StaticResource Text.Kpi}" Foreground="{StaticResource Brush.Removed}" Text="{Binding Removed, StringFormat=N0}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Pages changed"/>
                            <TextBlock Style="{StaticResource Text.Kpi}" Text="{Binding PagesChanged, StringFormat=N0}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="12,6">
                        <ItemsControl ItemsSource="{Binding Kinds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Kind}"/>
                                        <TextBlock Grid.Column="1" TextAlignment="Right" Foreground="{StaticResource Brush.Added}" Text="{Binding Added, StringFormat='+{0}'}"/>
                                        <TextBlock Grid.Column="2" TextAlignment="Right" Foreground="{StaticResource Brush.Edited}" Text="{Binding Edited, StringFormat='~{0}'}"/>
                                        <TextBlock Grid.Column="3" TextAlignment="Right" Foreground="{StaticResource Brush.Removed}" Text="{Binding Removed, StringFormat='−{0}'}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </StackPanel>
            <TextBlock Foreground="{StaticResource Brush.Removed}" Text="{Binding Error}" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource Conv.Visible}}"/>
        </Grid>

        <!-- ============ Pages | canvas | changes ============ -->
        <Grid Grid.Row="2" Margin="16,12,16,16" Visibility="{Binding HasResult, Converter={StaticResource Conv.Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.H2}" Text="Changed pages" Margin="12,10,12,6"/>
                    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Changed pages">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="12,6"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Text="{Binding Total}"/>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <Grid Height="4" Margin="0,4,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Fill}"/>
                                            <ColumnDefinition Width="{Binding Rest}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource Brush.Accent}" CornerRadius="2"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Text.Caption}">
                                        <Run Text="{Binding Added, StringFormat='+{0}', Mode=OneWay}" Foreground="{StaticResource Brush.Added}"/>
                                        <Run Text="{Binding Edited, StringFormat='~{0}', Mode=OneWay}" Foreground="{StaticResource Brush.Edited}"/>
                                        <Run Text="{Binding Removed, StringFormat='−{0}', Mode=OneWay}" Foreground="{StaticResource Brush.Removed}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,8">
                        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding ShowUnchanged}" Content="Show unchanged"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Rectangle Width="10" Height="3" Fill="{StaticResource Brush.Added}" Margin="0,0,4,0"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Added" Margin="0,0,10,0"/>
                            <Rectangle Width="10" Height="3" Fill="{StaticResource Brush.Edited}" Margin="0,0,4,0"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Edited (dashed = before)" Margin="0,0,10,0"/>
                            <Rectangle Width="10" Height="3" Fill="{StaticResource Brush.Removed}" Margin="0,0,4,0"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Removed"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.H2}" Text="{Binding SelectedPage.Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" Margin="12,4,12,8"
                               Text="Wheel: zoom · Drag: pan · Double-click or F: fit · Click a shape to inspect it"/>
                    <c:PageCanvas Margin="12,0" Items="{Binding CanvasItems}" SelectedKey="{Binding SelectedKey, Mode=TwoWay}"
                                  ShowUnchanged="{Binding ShowUnchanged}" AutomationProperties.Name="Page change overlay"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <TabControl BorderThickness="0" Background="Transparent">
                    <TabItem Header="On this page">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="10"
                                    MaxHeight="260" Visibility="{Binding HasSelectedItem, Converter={StaticResource Conv.Visible}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedItem.Fields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Field}"/>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{Binding Before, Mode=OneWay}" Foreground="{StaticResource Brush.Removed}" TextDecorations="Strikethrough"/>
                                                        <Run Text=" → " Foreground="{StaticResource Brush.Muted}"/>
                                                        <Run Text="{Binding After, Mode=OneWay}" Foreground="{StaticResource Brush.Added}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <ListBox ItemsSource="{Binding PageItems}" SelectedItem="{Binding SelectedItem}" BorderThickness="0"
                                     ItemTemplate="{StaticResource DiffRowTemplate}" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Changes on this page"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Not on a page">
                        <ListBox ItemsSource="{Binding OtherItems}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Changes not on a page">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2,0,6">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DiffRowTemplate}"/>
                                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding FieldSummary}" TextWrapping="Wrap" TextTrimming="None"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ============ Empty / busy states ============ -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                    Visibility="{Binding HasResult, Converter={StaticResource Conv.Collapsed}}">
            <TextBlock Style="{StaticResource Text.Icon}" FontSize="32" Text="&#xE8A9;" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Muted}"/>
            <TextBlock Style="{StaticResource Text.H1}" HorizontalAlignment="Center" Margin="0,10,0,4" Text="Compare two captures"/>
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"
                       Text="Pick an older and a newer capture (or the live project) and press Compare. Changed pages are listed by impact; each page shows exactly what was added, moved, edited or removed."/>
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None" Margin="0,10,0,0"
                       Foreground="{StaticResource Brush.Edited}"
                       Visibility="{Binding HasNoSnapshots, Converter={StaticResource Conv.Visible}}"
                       Text="Nothing captured yet. Use 'Capture Changes now' (or the ribbon button) to store the current project state, then compare it with a later capture or the live project."/>
        </StackPanel>

        <Border Grid.Row="0" Grid.RowSpan="3" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource Conv.Visible}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,16">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Width="220" Height="4"/>
                    <TextBlock Text="{Binding BusyText}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </DockPanel>
</Window>
