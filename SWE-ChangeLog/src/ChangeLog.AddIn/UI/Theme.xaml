<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:ChangeLog.AddIn.UI">

    <!-- SWEETs: the shared theme (src\SWEETs.UI\Theme.xaml) supplies the window header styles (Header.*), the implicit
         TextBox/CheckBox/ComboBox/DataGrid/ToolTip look and the palette. Change Log keeps its own control templates below
         (Card, Chip, Btn.*, … override the shared keys of the same name inside Change Log only); their tokens use the
         SWEETs palette. Added / Edited / Removed use the SWEETs Success / Warning / Danger colours. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SWEETs.UI;component/Theme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="Brush.Accent" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#1E40AF"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E8EEFD"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#111827"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="#4B5563"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#DADDE3"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#E9EBEF"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Canvas" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="Brush.Pressed" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="Brush.Added" Color="#047857"/>
    <SolidColorBrush x:Key="Brush.AddedSoft" Color="#E6F4EE"/>
    <SolidColorBrush x:Key="Brush.Edited" Color="#B45309"/>
    <SolidColorBrush x:Key="Brush.EditedSoft" Color="#FDF3E6"/>
    <SolidColorBrush x:Key="Brush.Removed" Color="#B91C1C"/>
    <SolidColorBrush x:Key="Brush.RemovedSoft" Color="#FBEAEA"/>

    <ui:ActionBrushConverter x:Key="Conv.Action"/>
    <ui:BoolToVisibilityConverter x:Key="Conv.Visible"/>
    <ui:BoolToVisibilityConverter x:Key="Conv.Collapsed" Invert="True"/>

    <!-- Keyboard focus ring: the SWEETs one. -->
    <Style x:Key="Focus" BasedOn="{StaticResource FocusRing}"/>

    <!-- Typography: SWEETs text styles. Text.Caption and Text.Kpi keep the pane's sizes (narrow docked pane) with the
         SWEETs colours; Text.H1 = Text.Subtitle, Text.H2 = section overline as in the other SWEETs tools. -->
    <Style x:Key="Text.H1" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}"/>
    <Style x:Key="Text.H2" TargetType="TextBlock" BasedOn="{StaticResource Text.Overline}"/>
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource InkSubtle}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Text.Kpi" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="Text.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Surfaces: SWEETs card (pane padding 12). -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Buttons: Btn = SWEETs secondary button. Btn.Primary and Btn.Ghost are the SWEETs ones (from SWEETs.UI). -->
    <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}"/>

    <!-- Filter chip (toggle): same shape as the SWEETs chip button; checked = accent. -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Inputs: SWEETs text box (compact). -->
    <Style x:Key="Input" TargetType="TextBox" BasedOn="{StaticResource Input.Small}"/>
    <Style x:Key="Secret" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Data grid: scannable rows, subtle dividers, no vertical lines. -->
    <Style x:Key="Grid.Header" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"/>
    <Style x:Key="Grid.Cell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Grid.Row" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Grid" TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Divider}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Grid.Header}"/>
        <Setter Property="CellStyle" Value="{StaticResource Grid.Cell}"/>
        <Setter Property="RowStyle" Value="{StaticResource Grid.Row}"/>
    </Style>

    <!-- Action pill (Added / Edited / Removed) used in grids and lists. -->
    <DataTemplate x:Key="ActionPill">
        <Border Style="{StaticResource Pill}" Background="{Binding Action, Converter={StaticResource Conv.Action}, ConverterParameter=soft}">
            <TextBlock Text="{Binding Action}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{Binding Action, Converter={StaticResource Conv.Action}}"/>
        </Border>
    </DataTemplate>
</ResourceDictionary>
