<Project>
  <!-- Shared settings. Version is overridden by build\build.ps1 -Version. -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <Company>Change Log for SOLIDWORKS Electrical</Company>
    <Product>Change Log for SOLIDWORKS Electrical</Product>
  </PropertyGroup>

  <!-- C# projects only (the WiX project imports this file too). -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <Copyright>© $([System.DateTime]::Now.Year)</Copyright>
    <TargetFramework>net48</TargetFramework>
    <!-- C# 7.3 is the .NET Framework 4.8 default; keeps the code compilable by every VS 2019/2022 toolchain. -->
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <!-- Makes net48 builds independent of an installed targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
