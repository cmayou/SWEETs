<Window x:Class="VendorGrid.UI.PriceBreaksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Price breaks" Width="520" Height="460" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Header.Bar}">
        <StackPanel>
            <TextBlock Style="{StaticResource Header.Overline}" Text="SWEETs · VendorGrid"/>
            <TextBlock x:Name="TitleText" Style="{StaticResource Header.Title}"/>
            <TextBlock x:Name="SubText" Style="{StaticResource Header.Subtitle}"/>
        </StackPanel>
    </Border>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="QUANTITY" Style="{StaticResource TH}"/>
                        <TextBlock Grid.Column="1" Text="UNIT PRICE" Style="{StaticResource TH}"/>
                        <TextBlock Grid.Column="2" Text="EXTENDED" Style="{StaticResource TH}"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TierList" AutomationProperties.Name="Price break table">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Padding="12,8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Quantity}" Style="{StaticResource Mono}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding UnitPrice}" Style="{StaticResource Mono}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Extended}" Style="{StaticResource Mono}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding CurrentMark}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoft}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Button Grid.Row="2" Content="Close" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
    </Grid>
    </DockPanel>
</Window>
