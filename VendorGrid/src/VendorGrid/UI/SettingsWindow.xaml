<Window x:Class="VendorGrid.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VendorGrid.UI"
        Title="VendorGrid — Settings" Width="900" Height="760" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Header.Bar}">
        <StackPanel>
            <TextBlock Style="{StaticResource Header.Overline}" Text="SWEETs · VendorGrid"/>
            <TextBlock Style="{StaticResource Header.Title}" Text="Settings"/>
            <TextBlock Style="{StaticResource Header.Subtitle}" Text="Vendors and their API keys, language and procurement country"/>
        </StackPanel>
    </Border>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Margin="16,12,16,0">

            <!-- ================= Vendors ================= -->
            <TabItem Header="Vendors" AutomationProperties.Name="Vendors">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vendor directory -->
                    <Border Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Vendors" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                           Text="Tick to include a vendor in every search. Star one to list it first. Select a vendor to set its credentials or connection."/>
                            </StackPanel>
                            <ListBox x:Name="VendorList" Grid.Row="1" ItemsSource="{Binding Vendors}" SelectedItem="{Binding SelectedVendor, Mode=TwoWay}"
                                     BorderBrush="{StaticResource Line}" AutomationProperties.Name="Vendor directory"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Style="{StaticResource StarToggle}" IsChecked="{Binding Favorite, Mode=TwoWay}"
                                                          ToolTip="Favourite: listed first" AutomationProperties.Name="Favourite vendor"/>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="6,0,8,0" VerticalAlignment="Center"
                                                      ToolTip="Include in searches" AutomationProperties.Name="Include in searches"/>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="+ Add vendor" Style="{StaticResource GhostButton}" Click="Add_Click" ToolTip="Add a vendor website, optionally with a live data API"/>
                                    <Button Content="Remove" Style="{StaticResource GhostButton}" Click="Remove_Click" Margin="8,0,0,0"
                                            IsEnabled="{Binding SelectedVendor.CanDelete, FallbackValue=False}" ToolTip="Remove the selected vendor (built-in vendors can only be disabled)"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Editor for the selected vendor: identity, credentials / connection, all in one place -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel DataContext="{Binding SelectedVendor}">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Muted}" Margin="0,2,0,6"/>
                                <TextBlock Text="{Binding NotesText}" Style="{StaticResource Muted}" Margin="0,0,0,10"
                                           Visibility="{Binding Notes, Converter={StaticResource NonEmptyToVis}}"/>

                                <!-- ============ Mouser ============ -->
                                <StackPanel Visibility="{Binding IsMouser, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Credentials" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Search API key" Style="{StaticResource Label}"/>
                                    <ui:SecretBox Label="Mouser API key" Value="{Binding DataContext.Settings.MouserApiKey, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Request a key at mouser.com/api-search. Without it Mouser is skipped and flagged “Setup needed”."/>
                                </StackPanel>

                                <!-- ============ Digi-Key ============ -->
                                <StackPanel Visibility="{Binding IsDigiKey, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Credentials" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Client ID" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding DataContext.Settings.DigiKeyClientId, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8" AutomationProperties.Name="Digi-Key client ID"/>
                                    <TextBlock Text="Client secret" Style="{StaticResource Label}"/>
                                    <ui:SecretBox Label="Digi-Key client secret" Value="{Binding DataContext.Settings.DigiKeyClientSecret, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Register an app at developer.digikey.com to get both values. Without them Digi-Key is skipped and flagged “Setup needed”."/>
                                </StackPanel>

                                <!-- ============ Newark ============ -->
                                <StackPanel Visibility="{Binding IsNewark, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Credentials" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                                    <TextBlock Text="API key" Style="{StaticResource Label}"/>
                                    <ui:SecretBox Label="Newark API key" Value="{Binding DataContext.Settings.NewarkApiKey, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Get a key at partner.element14.com. The regional store follows the country on the General tab."/>
                                </StackPanel>

                                <!-- ============ Any other website (built-in or added): one entry, link + optional API ============ -->
                                <StackPanel Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Name" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="Vendor name"/>

                                    <TextBlock Text="Website search page (use {pn} where the part number goes)" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding UrlTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" AutomationProperties.Name="Website search page"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                                               Text="Always available: each search gives a one-click link to this page for the part number."/>

                                    <CheckBox IsChecked="{Binding UseApi, Mode=TwoWay}" Margin="0,2,0,8"
                                              Content="Also pull live price and stock from this vendor's data API (JSON)"
                                              AutomationProperties.Name="Use a data API for live price and stock"/>

                                    <StackPanel Visibility="{Binding UseApi, Converter={StaticResource BoolToVis}}">
                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="Data API connection" Style="{StaticResource H2}"/>
                                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,8"
                                                           Text="This URL is called for every search and must return JSON. Map the fields below with dotted paths (for example data.items.0.sku). Leave the items path empty when the response itself is the list."/>
                                                <TextBlock Text="API URL (use {pn})" Style="{StaticResource Label}"/>
                                                <TextBox Text="{Binding ApiUrlTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="API URL"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Auth header name (optional)" Style="{StaticResource Label}"/>
                                                        <TextBox Text="{Binding AuthHeaderName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Auth header name"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Auth header value / API key" Style="{StaticResource Label}"/>
                                                        <ui:SecretBox Label="Custom vendor API key" Value="{Binding AuthHeaderValue, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="Test connection" Style="{StaticResource H2}"/>
                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding DataContext.TestPart, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                                     AutomationProperties.Name="Part number to test with" ToolTip="A part number this vendor is known to carry"/>
                                                            <Button Grid.Column="1" Content="Test" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="80" Click="Test_Click"
                                                                    IsEnabled="{Binding DataContext.CanTest, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding DataContext.TestResult, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                                                   AutomationProperties.LiveSetting="Polite"/>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="JSON field mapping" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,6,8"><TextBlock Text="Items path" Style="{StaticResource Label}"/><TextBox Text="{Binding ItemsPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Items path"/></StackPanel>
                                                    <StackPanel Margin="6,0,0,8"><TextBlock Text="Currency (ISO)" Style="{StaticResource Label}"/><TextBox Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Currency"/></StackPanel>
                                                    <StackPanel Margin="0,0,6,8"><TextBlock Text="Part number path" Style="{StaticResource Label}"/><TextBox Text="{Binding MpnPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Part number path"/></StackPanel>
                                                    <StackPanel Margin="6,0,0,8"><TextBlock Text="Vendor SKU path" Style="{StaticResource Label}"/><TextBox Text="{Binding SkuPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Vendor SKU path"/></StackPanel>
                                                    <StackPanel Margin="0,0,6,8"><TextBlock Text="Manufacturer path" Style="{StaticResource Label}"/><TextBox Text="{Binding ManufacturerPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Manufacturer path"/></StackPanel>
                                                    <StackPanel Margin="6,0,0,8"><TextBlock Text="Description path" Style="{StaticResource Label}"/><TextBox Text="{Binding DescriptionPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Description path"/></StackPanel>
                                                    <StackPanel Margin="0,0,6,8"><TextBlock Text="Stock quantity path" Style="{StaticResource Label}"/><TextBox Text="{Binding StockPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Stock path"/></StackPanel>
                                                    <StackPanel Margin="6,0,0,8"><TextBlock Text="Product page URL path" Style="{StaticResource Label}"/><TextBox Text="{Binding UrlPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Product URL path"/></StackPanel>
                                                    <StackPanel Margin="0,0,6,8"><TextBlock Text="Price breaks list path" Style="{StaticResource Label}"/><TextBox Text="{Binding BreaksPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Price breaks path"/></StackPanel>
                                                    <StackPanel Margin="6,0,0,8">
                                                        <TextBlock Text="Break fields (quantity / price)" Style="{StaticResource Label}"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding BreakQtyField, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Break quantity field"/>
                                                            <TextBox Grid.Column="2" Text="{Binding BreakPriceField, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Break price field"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Button Content="Reset to default" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Reset_Click"
                                            Visibility="{Binding IsBuiltinVendor, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Restore this vendor's shipped name and website link"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= General ================= -->
            <TabItem Header="General" AutomationProperties.Name="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Language" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,10"
                                           Text="By default VendorGrid uses the language of SOLIDWORKS Electrical. Choose a language to override it. Takes effect the next time the VendorGrid window is opened."/>
                                <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                                          SelectedValue="{Binding LanguageCode, Mode=TwoWay}" AutomationProperties.Name="Language"/>
                                <TextBlock Text="{Binding LanguageStatus}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Procurement country" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,10"
                                           Text="Sets the currency and the regional Digi-Key locale, Newark / Farnell store and RS Components portal used for searches."/>
                                <ComboBox ItemsSource="{Binding Countries}" DisplayMemberPath="Display" SelectedValuePath="Code"
                                          SelectedValue="{Binding CountryCode, Mode=TwoWay}" AutomationProperties.Name="Procurement country"/>
                                <TextBlock Text="{Binding RegionSummary}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>

                                <TextBlock Text="Optional overrides (leave blank to follow the country)" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Currency (ISO)" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding CurrencyOverride, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Currency override"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Digi-Key locale site" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding DigiKeyOverride, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Digi-Key locale site override"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Newark / Farnell store" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding NewarkOverride, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Newark store override"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Dashboard" Style="{StaticResource H2}"/>
                                <CheckBox Content="Show the live vendor status bar under the search box" IsChecked="{Binding Settings.ShowStatusBar}" Margin="0,10,0,0"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="22,2,0,0"
                                           Text="Response status, stock and timing per vendor, with one-click filters."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <TextBlock Text="Settings are stored encrypted for this Windows user." Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Style="{StaticResource GhostButton}" MinWidth="90" MinHeight="34"/>
                    <Button Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="8,0,0,0" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </DockPanel>
</Window>
