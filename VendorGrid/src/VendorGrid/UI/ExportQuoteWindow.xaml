<Window x:Class="VendorGrid.UI.ExportQuoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export quote" Width="860" Height="520" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Header.Bar}">
        <StackPanel>
            <TextBlock Style="{StaticResource Header.Overline}" Text="SWEETs · VendorGrid"/>
            <TextBlock Style="{StaticResource Header.Title}" Text="Export quote summary"/>
            <TextBlock x:Name="SubText" Style="{StaticResource Header.Subtitle}"/>
        </StackPanel>
    </Border>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <TextBox x:Name="PreviewBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     BorderThickness="0" Padding="12" AutomationProperties.Name="Quote text preview"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="ResultText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button x:Name="CopyButton" Content="Copy text" Style="{StaticResource GhostButton}" MinWidth="100" MinHeight="34" Click="Copy_Click"/>
            <Button Content="Save CSV…" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="8,0,0,0" Click="Save_Click"/>
            <Button Content="Close" IsCancel="True" Style="{StaticResource GhostButton}" MinWidth="80" MinHeight="34" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
    </DockPanel>
</Window>
