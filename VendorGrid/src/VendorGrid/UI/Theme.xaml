<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:VendorGrid.UI">

    <!-- SWEETs: the shared theme (src\SWEETs.UI\Theme.xaml) supplies the window header styles (Header.*), the tab
         styles and the palette. VendorGrid keeps its own control templates below; neutrals and accent use the SWEETs
         palette. The status colours (Good / Warn / Bad / Violet) stay VendorGrid's colour-blind-safe set (see README). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SWEETs.UI;component/Theme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Palette (SWEETs values). Text/background pairs meet WCAG AA. -->
    <SolidColorBrush x:Key="Bg" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="Ink" Color="#111827"/>
    <SolidColorBrush x:Key="InkMuted" Color="#4B5563"/>
    <SolidColorBrush x:Key="Line" Color="#DADDE3"/>
    <SolidColorBrush x:Key="LineStrong" Color="#B8BDC7"/>
    <SolidColorBrush x:Key="Accent" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentDark" Color="#1E40AF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E8EEFD"/>
    <SolidColorBrush x:Key="Good" Color="#0E7490"/>
    <SolidColorBrush x:Key="GoodSoft" Color="#ECFEFF"/>
    <SolidColorBrush x:Key="Warn" Color="#92400E"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="Bad" Color="#9D174D"/>
    <SolidColorBrush x:Key="Violet" Color="#7C3AED"/>
    <SolidColorBrush x:Key="VioletSoft" Color="#F5F3FF"/>
    <SolidColorBrush x:Key="Star" Color="#F59E0B"/>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <ui:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    <ui:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>
    <ui:NullToVisibilityConverter x:Key="NullToVis"/>

    <!-- ============ Text: SWEETs text styles under VendorGrid's names ============ -->
    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
        <Setter Property="FontSize" Value="17"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}"/>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style x:Key="TH" TargetType="TextBlock" BasedOn="{StaticResource Text.Overline}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ============ Surfaces ============ -->
    <!-- Card and Chip: the SWEETs ones (from SWEETs.UI). -->

    <!-- Small label badge: "Best price", "Alternate" ... (background and border set per tone). -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="Margin" Value="0,0,6,2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============ Inputs ============ -->
    <!-- TextBox, CheckBox, ComboBox: the SWEETs implicit styles. PasswordBox (vendor API keys) looks like the SWEETs text box. -->
    <Style TargetType="PasswordBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Buttons: the SWEETs buttons under VendorGrid's names ============ -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Btn.Primary}"/>
    <!-- VendorGrid's "ghost" button has a border: it is the SWEETs secondary button. -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}"/>
    <Style x:Key="BuyButton" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}"/>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextDecorations="Underline" Foreground="{TemplateBinding Foreground}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Foreground" Value="{StaticResource AccentHover}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Pill button (recent parts, quick quantities): the SWEETs chip button. -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource Btn.Chip}">
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- Toggles drawn like the SWEETs secondary / chip buttons; checked = accent. -->
    <Style x:Key="ToggleBase" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceAlt}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Show / Hide key field (SecretBox). -->
    <Style x:Key="GhostToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleBase}">
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>
    <!-- Vendor filter chips, quantity presets. Checked = active. -->
    <Style x:Key="FilterChip" TargetType="ToggleButton" BasedOn="{StaticResource ToggleBase}"/>

    <!-- Rectangular tile button: project parts. -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource Surface}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header nav tab (radio): Sourcing / Cost curve / BOM. -->
    <Style x:Key="NavTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Star favourite toggle. -->
    <Style x:Key="StarToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                        <TextBlock x:Name="T" Text="☆" FontSize="17" Foreground="{StaticResource LineStrong}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="T" Property="Text" Value="★"/>
                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource Star}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Foreground" Value="{StaticResource Star}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sortable column heading. -->
    <Style x:Key="SortHeader" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="2,2">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Tabs (Settings) ============ -->
    <!-- TabControl / TabItem: implicit styles come from SWEETs.UI (same look in every SWEETs tool). -->

    <!-- Thin progress / bar chart -->
    <Style x:Key="ThinBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="5"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
